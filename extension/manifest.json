{
  "manifest_version": 3,
  "name": "Cwtch \u2014 Watch parties for two",
  "short_name": "Cwtch",
  "version": "0.2.0",
  "description": "Private, encrypted watch parties for couples on Netflix, Prime Video, and YouTube.",
  "minimum_chrome_version": "124",
  "permissions": ["storage", "activeTab", "clipboardWrite", "scripting"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://*.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://*.primevideo.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cwtch",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*", "https://*.netflix.com/*"],
      "js": ["content/netflix-main-bridge.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://*.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "shared/protocol.js",
        "content/namespace.js",
        "content/constants.js",
        "content/utils.js",
        "content/diagnostics.js",
        "content/crypto.js",
        "content/platforms.js",
        "content/room-client.js",
        "content/sync-engine.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/logo.svg"],
      "matches": [
        "https://www.netflix.com/*",
        "https://*.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
