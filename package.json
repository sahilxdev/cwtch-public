{
  "name": "cwtch",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "start": "node relay/src/server.js",
    "test:browser": "node scripts/browser-check.mjs",
    "lint": "eslint extension relay/src scripts tests",
    "format": "prettier --write extension relay/src scripts tests docs README.md",
    "format:check": "prettier --check extension relay/src scripts tests docs README.md"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
